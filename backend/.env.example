AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=90

# Optional original Azure integration: set AI_PROVIDER=azure to use it.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-local-key

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_API_KEY=replace-with-your-local-key

# Optional shared-password gate (leave unset for local development)
# APP_ACCESS_PASSWORD=replace-with-demo-password
# APP_SESSION_SECRET=replace-with-long-random-secret
# ALLOWED_ORIGIN=http://localhost:5173
